# Copy to .env (gitignored) for local use, or paste these into Render's
# Environment tab. Real values live in Aiven / Render - never commit them.

# Aiven MySQL (service: cafeease-mysql, DigitalOcean blr).
# NOTE: JDBC uses sslMode=REQUIRED (camelCase). Aiven's console shows
# "ssl-mode=REQUIRED" which is MySQL CLI syntax and is NOT valid in a JDBC URL.
DB_URL=jdbc:mysql://cafeease-mysql-cafeease.a.aivencloud.com:20923/defaultdb?sslMode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=<copy from Aiven console - Connection information > Password>
DB_POOL_SIZE=5

# Comma-separated, NO trailing slash.
CORS_ALLOWED_ORIGINS=https://cafeease.vercel.app,http://localhost:3000

# Gmail app password. Generate a NEW one - the previous value is exposed
# in this repo's git history and must be treated as compromised.
MAIL_USERNAME=<your-gmail>
MAIL_PASSWORD=<16-char-app-password>

# One-time database seeding. Set SEED_ENABLED=true for the first deploy against an
# empty database; it is idempotent, so it is safe to leave on.
# NOTE: passwords are stored as plaintext (the app uses NoOpPasswordEncoder), so
# use a throwaway value here, not a real password.
SEED_ENABLED=true
SEED_ADMIN_EMAIL=<admin login email>
SEED_ADMIN_PASSWORD=<throwaway demo password>
