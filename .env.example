# Copy to .env (gitignored) or paste these into Render's Environment tab.
DB_URL=jdbc:mysql://<host>:<port>/<database>?useSSL=true&requireSSL=true
DB_USERNAME=<user>
DB_PASSWORD=<password>
DB_POOL_SIZE=5

# Comma-separated, NO trailing slash.
CORS_ALLOWED_ORIGINS=https://cafeease.vercel.app,http://localhost:3000

# Gmail app password. Generate a NEW one - the old value leaked in git history.
MAIL_USERNAME=<your-gmail>
MAIL_PASSWORD=<16-char-app-password>
